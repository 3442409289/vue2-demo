[{"name":"XR_H1","data":"常用单词","id":0},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th><strong>单词</strong></th>\n                    <th><strong>中文</strong></th>\n                    <th><strong>例句</strong></th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td><strong>hello</strong></td>\n                    <td>你好</td>\n                    <td>Hello, how are you? (你好，你好吗？)</td>\n                </tr>\n                <tr>\n                    <td><strong>goodbye</strong></td>\n                    <td>再见</td>\n                    <td>Goodbye, see you tomorrow! (再见，明天见！)</td>\n                </tr>\n                <tr>\n                    <td><strong>please</strong></td>\n                    <td>请</td>\n                    <td>Can you help me, please? (请问你能帮我吗？)</td>\n                </tr>\n                <tr>\n                    <td><strong>thank you</strong></td>\n                    <td>谢谢</td>\n                    <td>Thank you for your help. (谢谢你的帮助。)</td>\n                </tr>\n                <tr>\n                    <td><strong>sorry</strong></td>\n                    <td>对不起</td>\n                    <td>I'm sorry for being late. (对不起，我迟到了。)</td>\n                </tr>\n                <tr>\n                    <td><strong>yes</strong></td>\n                    <td>是的</td>\n                    <td>Yes, I agree with you. (是的，我同意你。)</td>\n                </tr>\n                <tr>\n                    <td><strong>no</strong></td>\n                    <td>不</td>\n                    <td>No, I don't think so. (不，我不这么认为。)</td>\n                </tr>\n                <tr>\n                    <td><strong>I</strong></td>\n                    <td>我</td>\n                    <td>I am a student. (我是一名学生。)</td>\n                </tr>\n                <tr>\n                    <td><strong>you</strong></td>\n                    <td>你</td>\n                    <td>You are very kind. (你非常善良。)</td>\n                </tr>\n                <tr>\n                    <td><strong>he</strong></td>\n                    <td>他</td>\n                    <td>He is my brother. (他是我的哥哥。)</td>\n                </tr>\n                <tr>\n                    <td><strong>she</strong></td>\n                    <td>她</td>\n                    <td>She is a teacher. (她是一名老师。)</td>\n                </tr>\n                <tr>\n                    <td><strong>it</strong></td>\n                    <td>它</td>\n                    <td>It is a beautiful day. (今天天气很好。)</td>\n                </tr>\n                <tr>\n                    <td><strong>we</strong></td>\n                    <td>我们</td>\n                    <td>We are going to the park. (我们要去公园。)</td>\n                </tr>\n                <tr>\n                    <td><strong>they</strong></td>\n                    <td>他们</td>\n                    <td>They are my friends. (他们是我的朋友。)</td>\n                </tr>\n                <tr>\n                    <td><strong>this</strong></td>\n                    <td>这个</td>\n                    <td>This is my book. (这是我的书。)</td>\n                </tr>\n                <tr>\n                    <td><strong>that</strong></td>\n                    <td>那个</td>\n                    <td>That is a good idea. (那是个好主意。)</td>\n                </tr>\n                <tr>\n                    <td><strong>here</strong></td>\n                    <td>这里</td>\n                    <td>Come here, please. (请到这里来。)</td>\n                </tr>\n                <tr>\n                    <td><strong>there</strong></td>\n                    <td>那里</td>\n                    <td>The store is over there. (商店在那边。)</td>\n                </tr>\n                <tr>\n                    <td><strong>what</strong></td>\n                    <td>什么</td>\n                    <td>What is your name? (你叫什么名字？)</td>\n                </tr>\n                <tr>\n                    <td><strong>where</strong></td>\n                    <td>哪里</td>\n                    <td>Where is the bathroom? (洗手间在哪里？)</td>\n                </tr>\n                <tr>\n                    <td><strong>when</strong></td>\n                    <td>什么时候</td>\n                    <td>When will you arrive? (你什么时候到？)</td>\n                </tr>\n                <tr>\n                    <td><strong>why</strong></td>\n                    <td>为什么</td>\n                    <td>Why are you late? (你为什么迟到？)</td>\n                </tr>\n                <tr>\n                    <td><strong>how</strong></td>\n                    <td>如何</td>\n                    <td>How do you do it? (你是怎么做到的？)</td>\n                </tr>\n                <tr>\n                    <td><strong>big</strong></td>\n                    <td>大的</td>\n                    <td>This is a big house. (这是一栋大房子。)</td>\n                </tr>\n                <tr>\n                    <td><strong>small</strong></td>\n                    <td>小的</td>\n                    <td>I have a small dog. (我有一只小狗。)</td>\n                </tr>\n                <tr>\n                    <td><strong>happy</strong></td>\n                    <td>开心的</td>\n                    <td>She is very happy today. (她今天很开心。)</td>\n                </tr>\n                <tr>\n                    <td><strong>sad</strong></td>\n                    <td>难过的</td>\n                    <td>He looks sad. (他看起来很伤心。)</td>\n                </tr>\n                <tr>\n                    <td><strong>good</strong></td>\n                    <td>好的</td>\n                    <td>This is a good book. (这是一本好书。)</td>\n                </tr>\n                <tr>\n                    <td><strong>bad</strong></td>\n                    <td>坏的</td>\n                    <td>That was a bad idea. (那是个坏主意。)</td>\n                </tr>\n                <tr>\n                    <td><strong>hot</strong></td>\n                    <td>热的</td>\n                    <td>The weather is hot today. (今天天气很热。)</td>\n                </tr>\n                <tr>\n                    <td><strong>cold</strong></td>\n                    <td>冷的</td>\n                    <td>I feel cold. (我觉得冷。)</td>\n                </tr>\n                <tr>\n                    <td><strong>new</strong></td>\n                    <td>新的</td>\n                    <td>I bought a new car. (我买了一辆新车。)</td>\n                </tr>\n                <tr>\n                    <td><strong>old</strong></td>\n                    <td>旧的</td>\n                    <td>This is an old photo. (这是一张旧照片。)</td>\n                </tr>\n                <tr>\n                    <td><strong>eat</strong></td>\n                    <td>吃</td>\n                    <td>I eat breakfast every morning. (我每天早上吃早餐。)</td>\n                </tr>\n                <tr>\n                    <td><strong>drink</strong></td>\n                    <td>喝</td>\n                    <td>Can I drink some water? (我能喝点水吗？)</td>\n                </tr>\n                <tr>\n                    <td><strong>go</strong></td>\n                    <td>去</td>\n                    <td>I go to school by bus. (我坐公交车去学校。)</td>\n                </tr>\n                <tr>\n                    <td><strong>come</strong></td>\n                    <td>来</td>\n                    <td>Please come here. (请过来。)</td>\n                </tr>\n                <tr>\n                    <td><strong>run</strong></td>\n                    <td>跑</td>\n                    <td>He runs every morning. (他每天早上跑步。)</td>\n                </tr>\n                <tr>\n                    <td><strong>walk</strong></td>\n                    <td>走</td>\n                    <td>Let's walk to the park. (我们走路去公园吧。)</td>\n                </tr>\n                <tr>\n                    <td><strong>read</strong></td>\n                    <td>读</td>\n                    <td>I like to read books. (我喜欢读书。)</td>\n                </tr>\n                <tr>\n                    <td><strong>write</strong></td>\n                    <td>写</td>\n                    <td>She writes a letter. (她写了一封信。)</td>\n                </tr>\n                <tr>\n                    <td><strong>work</strong></td>\n                    <td>工作</td>\n                    <td>I work in an office. (我在办公室工作。)</td>\n                </tr>\n                <tr>\n                    <td><strong>play</strong></td>\n                    <td>玩</td>\n                    <td>The children play in the park. (孩子们在公园里玩。)</td>\n                </tr>\n                <tr>\n                    <td><strong>sleep</strong></td>\n                    <td>睡觉</td>\n                    <td>I sleep at 10 PM. (我晚上10点睡觉。)</td>\n                </tr>\n                <tr>\n                    <td><strong>talk</strong></td>\n                    <td>说话</td>\n                    <td>We talk about the weather. (我们谈论天气。)</td>\n                </tr>\n                <tr>\n                    <td><strong>listen</strong></td>\n                    <td>听</td>\n                    <td>Listen to the music. (听音乐。)</td>\n                </tr>\n                <tr>\n                    <td><strong>see</strong></td>\n                    <td>看见</td>\n                    <td>I see a bird in the sky. (我看见天空中有只鸟。)</td>\n                </tr>\n                <tr>\n                    <td><strong>know</strong></td>\n                    <td>知道</td>\n                    <td>Do you know the answer? (你知道答案吗？)</td>\n                </tr>\n                <tr>\n                    <td><strong>think</strong></td>\n                    <td>想</td>\n                    <td>I think it's a good idea. (我觉得这是个好主意。)</td>\n                </tr>\n                <tr>\n                    <td><strong>feel</strong></td>\n                    <td>感觉</td>\n                    <td>I feel tired. (我觉得很累。)</td>\n                </tr>\n            </tbody>\n        </table>","id":1}]