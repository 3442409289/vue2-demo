   <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>In</td>\n                    <td>在……里面</td>\n                    <td><strong>The book is in the bag.</strong></td>\n                </tr>\n                <tr>\n                    <td>On</td>\n                    <td>在……上面</td>\n                    <td><strong>The cup is on the table.</strong></td>\n                </tr>\n                <tr>\n                    <td>At</td>\n                    <td>在……地点</td>\n                    <td><strong>I am at school.</strong></td>\n                </tr>\n                <tr>\n                    <td>With</td>\n                    <td>和……一起</td>\n                    <td><strong>I go to the park with my friend.</strong></td>\n                </tr>\n                <tr>\n                    <td>For</td>\n                    <td>为了</td>\n                    <td><strong>This gift is for you.</strong></td>\n                </tr>\n                <tr>\n                    <td>To</td>\n                    <td>到……</td>\n                    <td><strong>I go to school every day.</strong></td>\n                </tr>\n                <tr>\n                    <td>From</td>\n                    <td>从……</td>\n                    <td><strong>I am from China.</strong></td>\n                </tr>\n                <tr>\n                    <td>About</td>\n                    <td>关于</td>\n                    <td><strong>We are talking about the movie.</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":11},{"name":"XR_H3","data":"7. 常见连接词 (Common Conjunctions)","id":12},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>And</td>\n                    <td>和</td>\n                    <td><strong>I like apples and bananas.</strong></td>\n                </tr>\n                <tr>\n                    <td>But</td>\n                    <td>但是</td>\n                    <td><strong>I want to go, but I’m busy.</strong></td>\n                </tr>\n                <tr>\n                    <td>Or</td>\n                    <td>或者</td>\n                    <td><strong>Do you want tea or coffee?</strong></td>\n                </tr>\n                <tr>\n                    <td>Because</td>\n                    <td>因为</td>\n                    <td><strong>I stayed home because it rained.</strong></td>\n                </tr>\n                <tr>\n                    <td>If</td>\n                    <td>如果</td>\n                    <td><strong>If you study, you will pass.</strong></td>\n                </tr>\n                <tr>\n                    <td>So</td>\n                    <td>所以</td>\n                    <td><strong>I was tired, so I went to bed.</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":13},{"name":"XR_H3","data":"8. 常见疑问词 (Common Question Words)\n","id":14},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>What</td>\n                    <td>什么</td>\n                    <td><strong>What is your name?</strong></td>\n                </tr>\n                <tr>\n                    <td>Where</td>\n                    <td>哪里</td>\n                    <td><strong>Where are you from?</strong></td>\n                </tr>\n                <tr>\n                    <td>When</td>\n                    <td>什么时候</td>\n                    <td><strong>When is your birthday?</strong></td>\n                </tr>\n                <tr>\n                    <td>Why</td>\n                    <td>为什么</td>\n                    <td><strong>Why are you late?</strong></td>\n                </tr>\n                <tr>\n                    <td>Who</td>\n                    <td>谁</td>\n                    <td><strong>Who is your teacher?</strong></td>\n                </tr>\n                <tr>\n                    <td>How</td>\n                    <td>怎么</td>\n                    <td><strong>How are you?</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":15},{"name":"XR_H3","data":"9. 数字 (Numbers)\n","id":16},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>One</td>\n                    <td>一</td>\n                    <td><strong>I have one book.</strong></td>\n                </tr>\n                <tr>\n                    <td>Two</td>\n                    <td>二</td>\n                    <td><strong>There are two apples.</strong></td>\n                </tr>\n                <tr>\n                    <td>Three</td>\n                    <td>三</td>\n                    <td><strong>She has three cats.</strong></td>\n                </tr>\n                <tr>\n                    <td>Ten</td>\n                    <td>十</td>\n                    <td><strong>I need ten minutes.</strong></td>\n                </tr>\n                <tr>\n                    <td>Hundred</td>\n                    <td>一百</td>\n                    <td><strong>There are a hundred people.</strong></td>\n                </tr>\n                <tr>\n                    <td>Thousand</td>\n                    <td>一千</td>\n                    <td><strong>This costs two thousand dollars.</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":17},{"name":"XR_H3","data":"10. 时间相关词汇 (Time-related Words)\n","id":18},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>Today</td>\n                    <td>今天</td>\n                    <td><strong>Today is Monday.</strong></td>\n                </tr>\n                <tr>\n                    <td>Tomorrow</td>\n                    <td>明天</td>\n                    <td><strong>I will go to the park tomorrow.</strong></td>\n                </tr>\n                <tr>\n                    <td>Yesterday</td>\n                    <td>昨天</td>\n                    <td><strong>Yesterday was Sunday.</strong></td>\n                </tr>\n                <tr>\n                    <td>Now</td>\n                    <td>现在</td>\n                    <td><strong>I am busy now.</strong></td>\n                </tr>\n                <tr>\n                    <td>Later</td>\n                    <td>稍后</td>\n                    <td><strong>See you later!</strong></td>\n                </tr>\n                <tr>\n                    <td>Morning</td>\n                    <td>早上</td>\n                    <td><strong>I wake up in the morning.</strong></td>\n                </tr>\n                <tr>\n                    <td>Night</td>\n                    <td>晚上</td>\n                    <td><strong>I go to bed at night.</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":19}]