[{"name":"XR_H3","data":"1. 日常用语 (Daily Expressions)","id":0},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n                    <th>中文翻译</th>\n                    <th>例句</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>Hello</td>\n                    <td>你好</td>\n                    <td><strong>Hello! How are you?</strong></td>\n                </tr>\n                <tr>\n                    <td>Goodbye</td>\n                    <td>再见</td>\n                    <td><strong>Goodbye! See you tomorrow.</strong></td>\n                </tr>\n                <tr>\n                    <td>Please</td>\n                    <td>请</td>\n                    <td><strong>Please pass me the book.</strong></td>\n                </tr>\n                <tr>\n                    <td>Thank you</td>\n                    <td>谢谢</td>\n                    <td><strong>Thank you for your help.</strong></td>\n                </tr>\n                <tr>\n                    <td>Sorry</td>\n                    <td>对不起</td>\n                    <td><strong>Sorry, I’m late.</strong></td>\n                </tr>\n                <tr>\n                    <td>Yes</td>\n                    <td>是</td>\n                    <td><strong>Yes, I agree.</strong></td>\n                </tr>\n                <tr>\n                    <td>No</td>\n                    <td>不</td>\n                    <td><strong>No, I don’t think so.</strong></td>\n                </tr>\n                <tr>\n                    <td>Maybe</td>\n                    <td>也许</td>\n                    <td><strong>Maybe we can go later.</strong></td>\n                </tr>\n            </tbody>\n        </table>","id":1},{"name":"XR_H3","data":"2. 人称代词 (Personal Pronouns)","id":2},{"name":"XR_Temp","data":"<table>\n            <thead>\n                <tr>\n                    <th>单词</th>\n            